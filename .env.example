# SPNC compose stack (docs/37). Copy to .env and replace every value marked CHANGE_ME.
POSTGRES_USER=spnc
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=spnc

MINIO_ROOT_USER=spnc-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_min_8_chars
S3_BUCKET=spnc-snapshots

# JWT signing key: a long random string
SECRET_KEY=CHANGE_ME_long_random_secret

# Used only by `python -m app.cli create-admin` (docs/37 §3.2); at least 12 characters
SPNC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# Host port of the API
API_PORT=8000
